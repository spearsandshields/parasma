{
  "name": "@parasma/core",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spearsandshields/parasma.git",
    "directory": "packages/parasma-core"
  },
  "homepage": "https://github.com/spearsandshields/parasma#readme",
  "bugs": {
    "url": "https://github.com/spearsandshields/parasma/issues"
  },
  "version": "0.1.1",
  "description": "The Parasma engine for the browser: a WebAssembly layout and paint engine for .docx, .xlsx, .pptx and CSV, with an optional worker transport.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./parasma_wasm_bg.wasm": "./src/wasm/parasma_wasm_bg.wasm"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["dist", "README.md", "LICENSE", "NOTICE", "THIRD-PARTY-NOTICES.md", "THIRD-PARTY-LICENSES.md"],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./parasma_wasm_bg.wasm": "./dist/wasm/parasma_wasm_bg.wasm"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "bun run build && bun ../../scripts/publish-manifest.ts apply",
    "postpack": "bun ../../scripts/publish-manifest.ts restore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  }
}
