{
  "name": "@parasma/headless",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spearsandshields/parasma.git",
    "directory": "packages/headless"
  },
  "homepage": "https://github.com/spearsandshields/parasma#readme",
  "bugs": {
    "url": "https://github.com/spearsandshields/parasma/issues"
  },
  "version": "0.1.1",
  "description": "Framework-free kernel and plugins for the Parasma document viewer: loading, viewport, selection, clipboard, search, zoom and fonts, with no DOM.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["dist", "README.md", "LICENSE", "NOTICE", "THIRD-PARTY-NOTICES.md"],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "bun run build && bun ../../scripts/publish-manifest.ts apply",
    "postpack": "bun ../../scripts/publish-manifest.ts restore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "xstate": "^5",
    "@xstate/store": "^3",
    "@parasma/core": "workspace:*"
  }
}
