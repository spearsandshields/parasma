# Rust build artifacts
/target

# JS/TS
**/node_modules
**/.vite
**/dist
*.bak

# wasm-pack output is regenerated by `bun run build:wasm`
packages/*/src/wasm

# OS noise
.DS_Store
*.swp

# Editor / IDE
.idea
.vscode

# All fixture content is generated — run `bun run scripts/fetch-fixtures.ts`
/fixtures

# Local environment overrides
.env
.env.*
!.env.example
# Local copies of the ECMA-376 text (copyright Ecma International; never tracked)
/docs/spec/

# Test fonts for the native layout-regression harness — fetched, never committed
# (run: ./scripts/fetch-test-fonts.sh)
crates/parasma-wasm/test-fonts/

# The docx-only wasm identity baseline is recorded per machine and toolchain
# (scripts/check-wasm-identity.sh --record); a committed one would cite a
# commit and a compiler the next reader does not have.
wasm-baseline.json

# Snippet demo fixtures — copied (safe-filtered) from the /fixtures corpus by
# packages/snippet/scripts/copy-demo-fixtures.ts (predev). Never committed.
packages/snippet/demo/fixtures/
.debug-fonts/

# Third-party docx corpus for robustness sweeps (Apache POI and LibreOffice test
# files; see scripts/sweep-corpus.mjs for how to fetch it). Kept outside
# fixtures/ so the demo never copies it.
.corpus/

# publish-manifest.ts prepack state (transient; present only mid-pack): the
# manifest backup and the root licence files copied into each tarball.
packages/*/package.json.prepack-orig
packages/*/LICENSE
packages/*/NOTICE
packages/*/THIRD-PARTY-NOTICES.md

# Local calibration manifest: maps the IDs cited in comments (C1, C2, ...) to
# documents on disk. See docs/calibration-ids.md.
/.calibration

# Python bytecode from scripts/ (debug-fonts.py, generate-font-map.py).
__pycache__/
*.pyc
